# =====================================================================
# osmo-test-5 deploy/test config
# =====================================================================
# Static config for testnet deploys of the stack (factory +
# creator-pool + router). Pools pair against the
# chain's main native asset; the commit threshold is USD-denominated,
# valued via Osmosis x/twap (see the pricing section below).
# ---------------------------------------------------------------------

# ---- Chain ----
CHAIN_ID="osmo-test-5"
NODE="https://rpc.osmotest5.osmosis.zone:443"
GAS_PRICES="0.04uosmo"
GAS_ADJUSTMENT="1.3"
KEYRING="test"

# Test wallet name in the local keyring. The script reads its bech32
# address via `osmosisd keys show`, so this just has to match a
# pre-imported key. Faucet: https://faucet.testnet.osmosis.zone/
FROM="alice"

# ---- Denoms ----
# The chain's main native asset — this is what pools pair against and
# what the commit threshold is denominated in (`bluechip_denom` on the
# factory config). On osmo-test-5 that's uosmo; on Cosmos Hub, uatom;
# on Neutron, untrn.
NATIVE_DENOM="uosmo"

# ---- Wasm artifacts ----
ARTIFACTS="artifacts"

# ---- State file ----
# Runtime values written by the deploy script (code IDs, factory
# address, etc). Subsequent scripts source this in addition to the .env.
STATE_FILE="osmo_testnet.state"

# ---- USD pricing (Osmosis x/twap) ----
# Pool whose arithmetic TWAP prices NATIVE_DENOM in USD_QUOTE_DENOM.
# On testnet, create (or reuse) a NATIVE_DENOM/USD-stable pool and put
# its id here; the factory refuses pool_id 0. The manipulation cost of
# every USD valuation is the cost of moving THIS pool for the window.
# pricing_pool_id / USD_QUOTE_DENOM are now ONLY the cross-denom fee-swap
# route at threshold crossing (acquire the USDC gamm creation fee). They are
# NOT the price source — USD pricing is via Pyth (below).
PRICING_POOL_ID="314"
USD_QUOTE_DENOM="ibc/DE6792CF9E521F6AD6E9A4BDF6225C9571A3B74ACC0A529F92BC5122A39D2E58"

# ---- Pyth oracle (USD pricing) ----
# USD valuation of every commit comes from the Pyth OSMO/USD feed. The
# on-chain OSMO/USD pool substrate is too thin to price safely (~$1–3k to
# manipulate — see MAINNET_LIQUIDITY_RECON.md), so pricing moved to Pyth.
#
# ⚠ OPERATIONAL: Pyth on Osmosis is PUSH-based and the OSMO/USD feed is NOT
# kept fresh by the ecosystem (measured ~115 days stale). You MUST run a
# price keeper (Hermes → UpdatePriceFeeds) or the staleness gate fails every
# commit closed. Start the keeper BEFORE deploying (instantiate live-probes
# the feed and refuses a stale one).
#
# Pyth CW contract (MUST match the network):
#   osmo-test-5 (testnet): osmo1lltupx02sj99suakmuk4sr4ppqf34ajedaxut3ukjwkv6469erwqtpg9t3
#   osmosis-1  (mainnet):  osmo13ge29x4e2s63a8ytz2px8gurtyznmue4a69n5275692v3qn3ks8q7cwck7
PYTH_CONTRACT_ADDR="osmo1lltupx02sj99suakmuk4sr4ppqf34ajedaxut3ukjwkv6469erwqtpg9t3"
# OSMO/USD feed id (64-hex, no 0x). NOTE: Pyth uses DIFFERENT feed ids on
# testnet vs mainnet. Verified live: beta Hermes serves the testnet id fresh.
#   osmo-test-5 (testnet, beta Hermes): d9437c194a4b00ba9d7652cd9af3905e73ee15a2ca4152ac1f8d430cc322b857
#   osmosis-1  (mainnet):               5867f5683c757393a0670ef0f701490950fe93fdb006d181c8265a831ac0c5c6
PYTH_NATIVE_USD_FEED_ID="d9437c194a4b00ba9d7652cd9af3905e73ee15a2ca4152ac1f8d430cc322b857"
# Staleness gate (seconds, range 30..600). A price older than this fails
# closed — set it above your keeper's push cadence + slack.
PYTH_MAX_STALENESS_SECONDS="300"
# Confidence-interval gate (bps of price, range 50..500). Reject a price
# whose conf/price exceeds this (feed too dispersed). 200 = 2%.
PYTH_CONF_THRESHOLD_BPS="200"

# ---- Price keeper (scripts/run_price_keeper.sh) ----
# The wrapper sources THIS file, maps these to the CosmJS keeper's env var
# names, and runs `npm --prefix keepers run price-keeper`. The keeper pushes
# the OSMO/USD price to PYTH_CONTRACT_ADDR so the factory's staleness gate
# stays green.
#
# Hermes endpoint serving SIGNED updates for the target Pyth contract. The
# testnet Pyth contract verifies against Pyth's BETA guardian set, so testnet
# MUST use beta Hermes (mainnet uses https://hermes.pyth.network).
HERMES_ENDPOINT="https://hermes-beta.pyth.network"
# Keeper push cadence (ms). Keep well under PYTH_MAX_STALENESS_SECONDS.
PYTH_PUSH_INTERVAL_MS="60000"
# The keeper signs with a MNEMONIC (CosmJS can't read the osmosisd keyring
# that FROM= uses). It is a SECRET — do NOT put it here. Put it in
# `keepers/.env` (gitignored) as KEEPER_MNEMONIC=..., or export it in your
# shell before running the wrapper. Give the keeper its OWN wallet in prod;
# on testnet alice's mnemonic is fine for a rehearsal.

# ---- Factory tunables ----
# Commit threshold in USD micro-units (6 decimals):
# 25_000_000_000 = $25,000 (production). For a testnet rehearsal the
# threshold must be sized against the LIVE Pyth OSMO/USD price. At the
# current ~$0.032/OSMO a $20 threshold needs ~625 OSMO to cross — far
# more than a faucet key holds — so it is dropped to $0.25 here:
#   $0.25 / $0.032 ≈ 7.8 OSMO to cross (net seed ~7 OSMO, comfortably
#   above the 1-OSMO gamm creation fee so the H-01 seed<fee brick guard
#   is not tripped). Leaves headroom for 2–3 committers + deploy gas.
# Raise this back to the production value before mainnet.
COMMIT_THRESHOLD_LIMIT_USD="250000"
# Seconds between EmergencyWithdraw Phase 1 (initiate) and Phase 2 (drain).
# Pinned at factory instantiate; admin-tunable through ProposeConfigUpdate
# (48h timelock). Range: 60 .. 7d. Production default: 86_400 (24h).
EMERGENCY_WITHDRAW_DELAY_SECONDS="60"
COMMIT_FEE_BLUECHIP="0.01"
COMMIT_FEE_CREATOR="0.05"
# Per-pool max native-asset lock (25,000 tokens at 6 decimals).
MAX_BLUECHIP_LOCK_PER_POOL="25000000000"
CREATOR_EXCESS_LIQUIDITY_LOCK_DAYS="7"
# Flat pool-creation fee in base units of NATIVE_DENOM (1 token here).
# Charged on Create; forwarded to the protocol wallet, surplus
# refunded. Zero disables.
POOL_CREATION_FEE="1000000"
# The fee x/gamm auto-charges when the pool seeds its native balancer
# pool at threshold crossing. Funded from the 1% commit-fee retention
# (protocol revenue, never the creator); the pool self-corrects against
# the LIVE poolmanager fee at crossing (a mismatch reduces the seed,
# never bricks). Set to the chain's real fee COIN: `osmosisd q
# poolmanager params` — 1 OSMO (uosmo-denominated) on osmo-test-5 as of
# 2026-07. When a chain denominates it in the USD quote instead
# (osmosis-1: 20 Noble USDC), set the DENOM to USD_QUOTE_DENOM and the
# pool swaps its native retention into the fee coin at crossing.
GAMM_POOL_CREATION_FEE="1000000"
GAMM_POOL_CREATION_FEE_DENOM="uosmo"

# ---- Deploy knobs (optional) ----
# STORE_MODE: "direct" (default) uploads the wasms; "gov" skips uploads
# and requires the *_CODE_ID values below. osmo-test-5 is permissionless,
# so direct is right here.
# STORE_MODE="direct"
# Pre-existing code IDs — leave unset to upload fresh copies. Useful for
# reusing already-stored cw20-base / cw721-base code IDs.
# Post-TokenFactory-migration the factory no longer instantiates a CW20
# or NFT — these two IDs only satisfy legacy config fields, so reuse the
# copies already stored on osmo-test-5 instead of re-uploading.
CW20_CODE_ID="13242"
CW721_CODE_ID="13243"
# CREATOR_POOL_CODE_ID=""
# FACTORY_CODE_ID=""
# ROUTER_CODE_ID=""
# Protocol fee wallet (commit fees + creation fees). Defaults to the
# deployer address when unset — fine on testnet.
# PROTOCOL_WALLET=""

# ---- Sanity-check minimum balance ----
# Minimum uosmo (gas) balance the deploy script requires before it
# starts. Covers wasm uploads (the expensive part), instantiate txs,
# and a few commit-pool tests with comfort room. Faucet gives 10 OSMO
# per request.
MIN_GAS_BALANCE="15000000"
