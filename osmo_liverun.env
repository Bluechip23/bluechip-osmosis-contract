# =====================================================================
# osmo-test-5 LIVE-RUN config (5-pool functional exercise)
# =====================================================================
# Scratch env for the multi-committer live run. Points the factory at a
# controlled MOCK Pyth contract (fixed $10/OSMO) so USD thresholds are
# crossable with modest OSMO, and uses the integration-timing factory
# build (120s timelocks / 30s pool-create cooldown) so timelock flows and
# 5 back-to-back pool creations run on a real chain without 48h/1h waits.
# Economics are identical to the prod build (only the timing constants
# differ; the prod 48h/1h constants are proven by the test-tube E2E).
# Does NOT touch osmo_testnet.env / osmo_testnet.state.
# ---------------------------------------------------------------------

# ---- Chain ----
CHAIN_ID="osmo-test-5"
NODE="https://rpc.testnet.osmosis.zone:443"
GAS_PRICES="0.04uosmo"
GAS_ADJUSTMENT="1.3"
KEYRING="test"
FROM="alice"

# ---- Denoms ----
NATIVE_DENOM="uosmo"

# ---- Wasm artifacts ----
ARTIFACTS="artifacts"

# ---- State file (dedicated; does not clobber osmo_testnet.state) ----
STATE_FILE="osmo_liverun.state"

# ---- Cross-denom fee-swap route (NOT a price source) ----
PRICING_POOL_ID="314"
USD_QUOTE_DENOM="ibc/DE6792CF9E521F6AD6E9A4BDF6225C9571A3B74ACC0A529F92BC5122A39D2E58"

# ---- Pyth oracle (MOCK for this run) ----
# mock-pyth code 13284, instantiated for the live run. Fixed $10.00/OSMO
# (price 10_000_000 @ expo -6 -> rate 10_000_000). Re-SetPrice keeps it in
# the [10s, 300s] age window across the run.
PYTH_CONTRACT_ADDR="osmo1aqvmj8tpmf2gu5es27l87d9uxxxs7vv6p22kp8r8yjj4v3vs2jkqhhxt3l"
PYTH_NATIVE_USD_FEED_ID="d9437c194a4b00ba9d7652cd9af3905e73ee15a2ca4152ac1f8d430cc322b857"
PYTH_MAX_STALENESS_SECONDS="300"
PYTH_CONF_THRESHOLD_BPS="200"

# ---- Price keeper (not used for the mock run; kept for wrapper compat) ----
HERMES_ENDPOINT="https://hermes-beta.pyth.network"
PYTH_PUSH_INTERVAL_MS="60000"

# ---- Factory tunables ----
# $100 threshold (6-dec). At $10/OSMO that is 10 OSMO to cross; P4's
# smallest share (10% = $10) clears the $5 pre-threshold min-commit with
# margin. Sum of shares crosses cleanly; overshoot pools refund the excess.
COMMIT_THRESHOLD_LIMIT_USD="100000000"
EMERGENCY_WITHDRAW_DELAY_SECONDS="60"
COMMIT_FEE_BLUECHIP="0.01"
COMMIT_FEE_CREATOR="0.05"
# 4 OSMO native lock cap: the ~9 OSMO net raise (at $100/$10) exceeds it, so
# every crossing earmarks ~5 OSMO of creator excess -> ClaimCreatorExcessLiquidity
# is exercisable. lock_days=0 makes that excess claimable immediately (a real
# chain can't fast-forward the 7d prod lock; the lock duration itself is
# proven by unit/E2E tests).
MAX_BLUECHIP_LOCK_PER_POOL="4000000"
CREATOR_EXCESS_LIQUIDITY_LOCK_DAYS="0"
POOL_CREATION_FEE="1000000"
GAMM_POOL_CREATION_FEE="1000000"
GAMM_POOL_CREATION_FEE_DENOM="uosmo"

# ---- Deploy knobs ----
# Reuse already-stored code IDs (no re-store); re-instantiate factory+router.
CW20_CODE_ID="13242"
CW721_CODE_ID="13243"
CREATOR_POOL_CODE_ID="13285"
FACTORY_CODE_ID="13286"
ROUTER_CODE_ID="13287"

MIN_GAS_BALANCE="15000000"
