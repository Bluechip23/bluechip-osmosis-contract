# =====================================================================
# osmosis-1 (MAINNET) deploy config
# =====================================================================
# Osmosis mainnet wasm uploads are GOVERNANCE-GATED: either each wasm is
# stored via a StoreCode gov proposal, or governance grants the deployer
# address standing upload permission. See docs/OSMOSIS_DEPLOY.md.
#
# STORE_MODE=gov    -> fill in the *_CODE_ID values below from the passed
#                      proposals; the script only instantiates.
# STORE_MODE=direct -> only valid if the deployer address has been
#                      granted upload permission by governance.
# ---------------------------------------------------------------------

CHAIN_ID="osmosis-1"
NODE="https://rpc.osmosis.zone:443"
GAS_PRICES="0.025uosmo"
GAS_ADJUSTMENT="1.4"
KEYRING="os"
FROM="deployer"

STORE_MODE="gov"
# Fill these from the passed StoreCode proposals (or leave empty and use
# STORE_MODE=direct if governance granted the deployer upload rights):
CREATOR_POOL_CODE_ID=""
FACTORY_CODE_ID=""
ROUTER_CODE_ID=""
# cw20-base and cw721-base are already stored on osmosis-1 by other
# projects; you can reuse an existing audited code ID instead of storing
# your own copies — verify the code hash matches the published release.
CW20_CODE_ID=""
CW721_CODE_ID=""

# ---- Denoms ----
# Pools pair against OSMO; commits are valued in USD via Pyth (below).
NATIVE_DENOM="uosmo"

ARTIFACTS="artifacts"
STATE_FILE="osmosis_mainnet.state"

# ---- Cross-denom fee-swap route ----
# PRICING_POOL_ID / USD_QUOTE_DENOM are ONLY the execution route the pool
# uses at threshold crossing to swap its native fee retention into the
# USDC-denominated x/gamm pool-creation fee. They are NOT a price source
# (USD pricing is via Pyth below), so the pool only needs enough
# liquidity to fill that small (~$20) swap. Point it at an OSMO/USDC
# pool on osmosis-1 (verify the current pool id and Noble USDC denom on
# app.osmosis.zone before deploying).
PRICING_POOL_ID=""
# Noble USDC on osmosis-1:
USD_QUOTE_DENOM="ibc/498A0751C798A0D9A389AA3691123DADA57DAA4FE165D5C75894505B876BA6E4"

# ---- Pyth oracle (USD pricing) ----
# USD valuation of every commit comes from the Pyth OSMO/USD feed, gated
# fail-closed for staleness and confidence (see osmo_testnet.env for the
# full operational notes).
#
# ⚠ OPERATIONAL: Pyth on Osmosis is PUSH-based and the OSMO/USD feed is
# NOT kept fresh by the ecosystem. You MUST run the price keeper
# (scripts/run_price_keeper.sh, Hermes → UpdatePriceFeeds) or the
# staleness gate fails every commit closed. Start the keeper BEFORE
# deploying (instantiate live-probes the feed and refuses a stale one).
#
# Pyth CW contract on osmosis-1:
PYTH_CONTRACT_ADDR="osmo13ge29x4e2s63a8ytz2px8gurtyznmue4a69n5275692v3qn3ks8q7cwck7"
# OSMO/USD feed id on mainnet (64-hex, no 0x — differs from testnet):
PYTH_NATIVE_USD_FEED_ID="5867f5683c757393a0670ef0f701490950fe93fdb006d181c8265a831ac0c5c6"
# Staleness gate (seconds, range 30..600) — keep above the keeper's push
# cadence + slack.
PYTH_MAX_STALENESS_SECONDS="300"
# Confidence-interval gate (bps of price, range 50..500). 200 = 2%.
PYTH_CONF_THRESHOLD_BPS="200"

# ---- Price keeper (scripts/run_price_keeper.sh) ----
# Mainnet Pyth verifies against the production guardian set — use the
# production Hermes endpoint (testnet uses hermes-beta).
HERMES_ENDPOINT="https://hermes.pyth.network"
# Keeper push cadence (ms). Keep well under PYTH_MAX_STALENESS_SECONDS.
PYTH_PUSH_INTERVAL_MS="60000"

# ---- Factory tunables ----
# Commit threshold in USD micro-units (6 decimals):
# 25_000_000_000 = $25,000. Committers pay in OSMO; the factory values
# each commit via the Pyth price above.
COMMIT_THRESHOLD_LIMIT_USD="25000000000"
EMERGENCY_WITHDRAW_DELAY_SECONDS="86400"
COMMIT_FEE_BLUECHIP="0.01"
COMMIT_FEE_CREATOR="0.05"
# Per-pool max OSMO lock (base units).
MAX_BLUECHIP_LOCK_PER_POOL="25000000000"
CREATOR_EXCESS_LIQUIDITY_LOCK_DAYS="7"
# Flat pool-creation fee in uosmo (1 OSMO). Zero disables.
POOL_CREATION_FEE="1000000"
# The fee x/gamm auto-charges at threshold crossing. On osmosis-1 this
# is denominated in NOBLE USDC (20 USDC as of 2026-07 — re-verify with
# `osmosisd q poolmanager params --node $NODE` before deploying). The
# pool funds it from the 1% commit-fee retention and swaps native →
# USDC through the pricing pool at crossing; the creator never pays.
# The denom MUST match USD_QUOTE_DENOM (or NATIVE_DENOM if governance
# ever re-denominates the fee) — anything else fails validation.
GAMM_POOL_CREATION_FEE="20000000"
GAMM_POOL_CREATION_FEE_DENOM="ibc/498A0751C798A0D9A389AA3691123DADA57DAA4FE165D5C75894505B876BA6E4"

# Protocol fee wallet (receives commit fees + creation fees). Defaults
# to the deployer address when unset — set this to the real multisig.
PROTOCOL_WALLET=""

# Minimum uosmo gas balance required before starting.
MIN_GAS_BALANCE="20000000"
