# =====================================================================
# osmosis-1 (MAINNET) deploy config
# =====================================================================
# Wasm uploads on osmosis-1 are GOVERNANCE-GATED: each contract is stored
# via its own StoreCode proposal (one per contract — a combined proposal
# does not fit the ~60M per-tx gas cap).
# STORE_MODE=gov => the script does NOT upload; it only instantiates.
# ---------------------------------------------------------------------

CHAIN_ID="osmosis-1"
NODE="https://rpc.osmosis.zone:443"
# osmosis-1 uses an EIP-1559 base fee (0.03 uosmo as of 2026-08-30) and it
# MOVES. 0.04 leaves headroom; you only pay gas actually used. Re-check:
#   curl -s https://lcd.osmosis.zone/osmosis/txfees/v1beta1/cur_eip_base_fee
GAS_PRICES="0.04uosmo"
GAS_ADJUSTMENT="1.4"
KEYRING="file"
FROM="mainnet-deployer"

STORE_MODE="gov"
# Set from the passed StoreCode proposals for the native-threshold builds
# (factory data_hash b2d5e501…, creator_pool data_hash 5954bb79…) before
# running the script. Verify each with:
#   osmosisd q wasm code-info <id> --node $NODE   (compare data_hash)
FACTORY_CODE_ID=""
CREATOR_POOL_CODE_ID=""
# prop #1040, data_hash ea5c69bb… verified on-chain — the router bytes are
# unchanged by the native-threshold build, so code 1903 is reused as-is.
ROUTER_CODE_ID="1903"
# LEGACY, VESTIGIAL — READ BY NOTHING. These two fields survive from the
# pre-TokenFactory design. They are stored on FactoryInstantiate and never
# read for any logic, never validated, and no CW20 or NFT contract is ever
# instantiated (the creator token is a TokenFactory denom). They only have to
# be non-empty for the deploy script, so they point at existing osmosis-1 code
# ids. Stock cw20-base / cw721-base release builds are NOT stored on
# osmosis-1 (all 1902 code ids checked), so there is nothing more meaningful
# to point at.
CW20_CODE_ID="1"
CW721_CODE_ID="2"

# ---- Admin / migrate authority ----
# Becomes BOTH the wasmd migrate admin AND the in-contract admin
# (factory_admin_address + router admin). deploy_osmosis.sh REFUSES to run
# against osmosis-1 without it: a single-EOA migrate admin can migrate to
# malicious code and bypass every in-contract timelock.
#
# SDK legacy multisig, 2-of-4. Derived from these four member pubkeys — the
# address is reproducible by anyone, it holds no key of its own:
#   osmo1zdnw3vdn4ekaxyjg29tq5djl7la6l343zrx3dg  AxRwIvz4+HtfJ5fS9t68sVWx/QfMK8yKFEcYP+KTgcAV
#   osmo1v722cdqqt9kmvx570m0t2tsa5s5wv4v6jwvpa9  Au9IOl/TQMGdXQFrov7bdUR8u5mzAyErptyDeD203oaF
#   osmo1kjq73e2ezuwzvyje5e444rl9u9t9f8z38guv8g  AqaYJrbL2H09iFAu6WeShKaK06HRO7xSrt/x3kKFJoIo
#   osmo1m7zvlquc5gupmwjqa0nc57mzsq3ll8uvp5qsmn  A9USpnBtcH9bWhPLX1ygmg9smC30ZSy2OhFTS3yTc0+f
# Chosen over cw3-flex because cw-plus cw3/cw4 are NOT stored on osmosis-1
# (all 1902 code ids checked) and storing them would need another governance
# cycle. NOTE: SDK multisig membership is PERMANENT — replacing a signer means
# creating a new multisig and re-rotating admin on both contracts.
ADMIN_MULTISIG="osmo1ejzfu7fspj5ygqdq4kzr63af2r88taw4ks5an3"

# ---- Denoms ----
NATIVE_DENOM="uosmo"
ARTIFACTS="artifacts"
STATE_FILE="osmosis_mainnet.state"

# ---- Cross-denom fee-swap route (the ONLY price read in the protocol) ----
# x/gamm charges the pool-creation fee in ALLOYED USDC on osmosis-1 (verified
# live 2026-08-30 via `osmosisd q poolmanager params`). The contract requires
# gamm_pool_creation_fee.denom == NATIVE_DENOM or == FEE_QUOTE_DENOM, so
# FEE_QUOTE_DENOM is set to alloyed USDC — NOT Noble USDC. Using Noble USDC
# here would make the fee denom unroutable and BRICK every crossing.
#
# The pricing pool's trailing 600s TWAP budgets ONLY this ~20 USDC fee
# swap; it never values commits or the threshold, and the swap's spend is
# hard-clamped to the protocol's own 1%-retention reserve.
#
# PRICING_POOL_ID must trade uosmo <-> FEE_QUOTE_DENOM directly (single-hop:
# the crossing emits one MsgSwapExactAmountOut through this pool). Pool 3499
# is the direct uosmo/allUSDC concentrated-liquidity pool.
#
# !! DEPTH WARNING: pool 3499 held only ~823 allUSDC / ~37k OSMO (~$2.1k) on
# 2026-08-30. The 20 USDC fee swap is ~2.4% of its USDC side. The crossing
# budgets FEE_SWAP_MARGIN_BPS (20%) of slippage headroom and REVERTS (whole
# crossing, recoverable, funds safe) if the swap would exceed it. RE-CHECK
# THIS POOL'S DEPTH before launch and prefer a deeper uosmo/allUSDC pool if
# one exists:
#   curl -s $NODE_LCD/osmosis/poolmanager/v1beta1/pools/3499/total_pool_liquidity
PRICING_POOL_ID="3499"
FEE_QUOTE_DENOM="factory/osmo147h5x9pcj7lm0cttlaefx6sqq5vdfnmwfcqxkmjd7exqm9gc7grqhr75m0/alloyed/allUSDC"

# ---- Factory tunables ----
# Commit threshold in NATIVE base units (6 decimals): 500,000 OSMO. There
# is no oracle — a commit's value toward the threshold IS its attached
# uosmo. The number is expected to be retuned over time through the 48h
# ProposeConfigUpdate flow (applies to pools created AFTER the change) so
# its USD equivalent stays sane as the OSMO price moves.
COMMIT_THRESHOLD_LIMIT_NATIVE="500000000000"
# Delay between EmergencyWithdraw phase 1 (initiate+pause) and phase 2
# (drain). Range 6h .. 7d on the production build. 24h.
EMERGENCY_WITHDRAW_DELAY_SECONDS="86400"
COMMIT_FEE_BLUECHIP="0.01"
COMMIT_FEE_CREATOR="0.05"
# Per-pool max OSMO locked into pool reserves; the remainder becomes
# time-locked creator excess (base units — 25,000 OSMO).
MAX_BLUECHIP_LOCK_PER_POOL="25000000000"
CREATOR_EXCESS_LIQUIDITY_LOCK_DAYS="7"
# Flat creation fee charged on Create, forwarded to PROTOCOL_WALLET (1 OSMO).
POOL_CREATION_FEE="1000000"
# Live x/gamm creation fee, verified 2026-08-30. Funded from the protocol's
# 1% commit-fee retention — never by the creator. Re-verify before deploying:
#   osmosisd query poolmanager params --node $NODE
GAMM_POOL_CREATION_FEE="20000000"
GAMM_POOL_CREATION_FEE_DENOM="factory/osmo147h5x9pcj7lm0cttlaefx6sqq5vdfnmwfcqxkmjd7exqm9gc7grqhr75m0/alloyed/allUSDC"

# Protocol fee wallet (commit fees + creation fees + emergency-drain
# recipient). This is the deployer EOA, which is also multisig member #1.
# A compromise of this key exposes accumulated protocol fees (it does NOT
# grant admin authority — that needs 2-of-4). Changeable later through the
# standard 48h ProposeConfigUpdate flow if you move to a treasury.
PROTOCOL_WALLET="osmo1zdnw3vdn4ekaxyjg29tq5djl7la6l343zrx3dg"

# Minimum uosmo gas balance required before the script starts.
MIN_GAS_BALANCE="20000000"
